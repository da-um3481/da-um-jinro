        };
        
        // 기존 스케줄이 있으면 업데이트, 없으면 새로 생성
        let response;
        if (currentSchedule) {
            response = await fetch(`tables/weekly_schedules/${currentSchedule.id}`, {
                method: 'PUT',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({...currentSchedule, ...scheduleData})
            });
